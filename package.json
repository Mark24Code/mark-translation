{
  "name": "mark-translation",
  "version": "1.0.0",
  "description": "A browser extension for Chinese-English translation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome",
    "preview": "vite preview",
    "build:firefox": "vite build --mode firefox && node scripts/post-build.js firefox",
    "build:chrome": "vite build --mode chrome && node scripts/post-build.js chrome"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.1",
    "axios": "^1.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.246",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-web-extension": "^4.1.0"
  }
}